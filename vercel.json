{
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/images/(.*)", "destination": "/images/$1" },
    { "source": "/fonts/(.*)", "destination": "/fonts/$1" },
    { "source": "/work/(.*)", "destination": "/pages/work/$1" },
    { "source": "/(.*)", "destination": "/pages/$1" }
  ]
}
